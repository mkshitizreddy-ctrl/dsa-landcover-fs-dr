digraph {
    rankdir=TB; nodesep=0.35; ranksep=0.45;
    edge [fontname="Helvetica", fontsize=11];
    node [shape=box, style="rounded,filled", fillcolor="#eef2f7", fontname="Helvetica"];
    data [label="Dataset\n(Landsat, pcap)"];
    split [label="Split\n(Landsat: official train / test;\npcap: grouped by Hash)"];
    scale [label="Imputation\nand scaling"];
    mi [label="Mutual information\n(mi.py, merge sort)"];
    corr [label="Correlation graph\n(graph.py)"];
    heap [label="Heap + BFS selection\n(heap.py, selection.py)"];
    pca [label="PCA / KernelPCA / LDA\n(pca.py, scikit-learn)"];
    clf [label="Classifier\n(kNN with KD-tree, RF,\nXGBoost, DT, SVM)"];
    score [label="Macro-F1\n(cross-validation,\ntraining rows only)"];
    mh [label="10 metaheuristics\n(Mealpy)\nchoose t, k, a feature mask\nor a whole pcap configuration", fillcolor="#fdf1e3"];
    grid [label="pcap grid search\n(924 configurations,\ntrue optimum known)", fillcolor="#fdf1e3"];
    final [label="Final test on held-out data\n(sat.tst; unseen pcap hashes)\neach test set used once", fillcolor="#e3f1e6"];
    data -> split;
    split -> scale [label="training rows"];
    scale -> mi -> heap;
    scale -> corr -> heap;
    heap -> clf;
    scale -> pca -> clf;
    heap -> pca [style=dashed];
    clf -> score;
    score -> mh [label="fitness"];
    mh -> heap [label="threshold t, mask", style=dashed];
    mh -> pca [label="components k", style=dashed];
    score -> grid [label="pcap: every\nconfiguration"];
    grid -> mh [label="search space", style=dashed];
    score -> final [label="chosen settings"];
    split -> final [label="test rows", style=dashed];
}
